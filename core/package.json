{
  "name": "dreamflutter-core",
  "private": true,
  "version": "0.5.0-dev.6",
  "description": "DreamFlutter background service: hosts Pi sessions in-process and serves the desktop UI over a local WebSocket.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "croner": "9.1.0",
    "pdfjs-dist": "4.10.38",
    "undici": "8.10.2",
    "ws": "8.18.3",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.18.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "jsdom": "29.0.2",
    "typescript": "5.9.3"
  }
}
